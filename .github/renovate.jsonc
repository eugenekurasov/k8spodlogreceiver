{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "ignorePaths": ["build/**"],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],

  "packageRules": [
    {
      "groupName": "all dependencies",
      "matchPackageNames": ["**"]
    },
    {
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go"
      ]
    },
    {
      "matchDepNames": ["kindest/node"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchPackageNames": ["github.com/cenkalti/backoff/v4"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "Module pins in the ocb builder manifest",
      "managerFilePatterns": ["builder-config.yaml"],
      "matchStrings": [
        "gomod:\\s+(?<depName>(?:go\\.opentelemetry\\.io|github\\.com/open-telemetry)/\\S+)\\s+(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "ocb version, pinned in CI and repeated in the builder-config header and README",
      "managerFilePatterns": [
        "builder-config.yaml",
        ".github/workflows/ci.yml",
        "README.md"
      ],
      "matchStrings": [
        "go install (?<depName>go\\.opentelemetry\\.io/collector/cmd/builder)@(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Collector stable (v1.x) version quoted in the README status table and build notes",
      "managerFilePatterns": ["README.md"],
      "matchStrings": [
        "(?:pinned to|core) `?(?<currentValue>v1\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "go.opentelemetry.io/collector/pdata",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Collector unstable (v0.x) version quoted in the README status table and build notes",
      "managerFilePatterns": ["README.md"],
      "matchStrings": [
        "/ `?(?<currentValue>v0\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "go.opentelemetry.io/collector/service",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "kind node images in the integration matrix",
      "managerFilePatterns": [".github/workflows/integration.yml"],
      "matchStrings": [
        "kind-image:\\s+\"(?<depName>kindest/node):(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
